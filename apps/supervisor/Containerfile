FROM node:22-alpine@sha256:9bef0ef1e268f60627da9ba7d7605e8831d5b56ad07487d24d1aa386336d1944 AS node-22-alpine

WORKDIR /app

FROM node-22-alpine AS pruner

COPY --chown=node:node . .
RUN npx -q turbo@1.10.9 prune --scope=supervisor --docker

FROM node-22-alpine AS base

USER root
RUN apk add --no-cache dumb-init

COPY --chown=node:node .gitignore .gitignore
COPY --from=pruner --chown=node:node /app/out/json/ .
# Use full lockfile and root package.json to preserve patch information
COPY --chown=node:node pnpm-lock.yaml ./pnpm-lock.yaml
COPY --chown=node:node package.json ./package.json
COPY --from=pruner --chown=node:node /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml

RUN corepack enable && corepack prepare --activate

FROM base AS deps-fetcher
USER root
RUN apk add --no-cache build-base python3-dev py3-setuptools make

# Copy patches directory to ensure they're available for patched dependencies
COPY --chown=node:node patches/ ./patches/

FROM deps-fetcher AS dev-deps
ENV NODE_ENV development

# Install with full lockfile to preserve patches and CVE overrides
# Use frozen lockfile to ensure patches are applied
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --ignore-scripts

FROM base AS builder

COPY --from=pruner --chown=node:node /app/out/full/ .
COPY --from=dev-deps --chown=node:node /app/ .
COPY --chown=node:node turbo.json turbo.json
COPY --chown=node:node .configs/tsconfig.base.json .configs/tsconfig.base.json
COPY --chown=node:node scripts/updateVersion.ts scripts/updateVersion.ts
# Ensure root package.json with overrides is available for deployment
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node patches/ ./patches/

RUN pnpm run generate && \
  pnpm run --filter supervisor... build && \
  pnpm deploy --filter=supervisor --prod /prod/supervisor && \
  echo "=== Replacing vulnerable packages with fixed versions ===" && \
  echo "--- Directly removing tar-fs@2.1.3 ---" && \
  rm -rf /prod/supervisor/node_modules/.pnpm/tar-fs@2.1.3 && \
  echo "--- Copying fixed tar-fs@3.1.1 ---" && \
  cp -r node_modules/.pnpm/tar-fs@3.1.1 /prod/supervisor/node_modules/.pnpm/ && \
  cp -r node_modules/.pnpm/tar-stream@3.1.7 /prod/supervisor/node_modules/.pnpm/ 2>/dev/null || true && \
  echo "--- Directly removing cross-spawn@7.0.3 ---" && \
  rm -rf /prod/supervisor/node_modules/.pnpm/cross-spawn@7.0.3 && \
  echo "--- Copying fixed cross-spawn@7.0.5 (already done) ---" && \
  echo "=== Package replacement complete ==="

FROM base AS runner

ENV NODE_ENV production

COPY --from=builder /prod/supervisor /app/apps/supervisor

EXPOSE 8000
USER node

# ensure pnpm is installed during build and not silently downloaded at runtime
RUN pnpm -v

CMD [ "/usr/bin/dumb-init", "--", "pnpm", "run", "--filter", "supervisor", "start"]
